---
// LanguageToggle (구 MatrixRain 자리 대체)
---
<button id="langToggleBtn" class="flex items-center gap-1 border border-primary/50 px-2 py-1 hover:bg-primary/20 transition-colors cursor-pointer z-50 pointer-events-auto">
  🌐 <span id="langLabel">KOR</span>
</button>

<script>
  const langBtn = document.getElementById('langToggleBtn');
  const langLabel = document.getElementById('langLabel');

  // 처음 사이트를 켰을 때 기본 한국어로 설정
  document.body.classList.add('lang-ko');

  langBtn?.addEventListener('click', () => {
    const isKorean = document.body.classList.contains('lang-ko');
    
    if (isKorean) {
      document.body.classList.remove('lang-ko');
      document.body.classList.add('lang-en');
      if(langLabel) langLabel.textContent = 'ENG';
    } else {
      document.body.classList.remove('lang-en');
      document.body.classList.add('lang-ko');
      if(langLabel) langLabel.textContent = 'KOR';
    }
  });
</script>

<style is:global>
  /* 한국어 모드일 때는 영어 글자 숨기기 */
  body.lang-ko .only-en { display: none !important; }
  
  /* 영어 모드일 때는 한국어 글자 숨기기 */
  body.lang-en .only-ko { display: none !important; }
</style>
